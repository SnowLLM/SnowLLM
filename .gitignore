# Python
__pycache__/
*.py[cod]
*.egg-info/
/.pytest_cache/
/dist/
/build/

# Benchmark output. The harness is tracked; a run's numbers are not -- they belong to one box on
# one day, and BENCHMARK.md is where the ones worth keeping get written down with their conditions.
/benchmarks/results/*
!/benchmarks/results/.gitkeep

# Brand rasters for GitHub. render-brand.py is tracked; the avatar and social preview it draws are
# not -- nothing here reads them, they are uploaded by hand in a settings page and that is the whole
# of their life. web/og.png is the exception and stays tracked, because the site serves it.
/brand/

# Editor / tooling caches
/.cache/
/.claude/settings.local.json

# Profiler output
.rocprofv3/
*.pftrace
*.json.gz

# Manual backups
*.bak


/.vscode